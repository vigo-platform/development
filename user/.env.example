# Internal ports used by Compose and Prometheus
SERVER_PORT=8081
MANAGEMENT_PORT=8082
MANAGEMENT_ADDRESS=0.0.0.0

# Match the credentials in postgres/.env.
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/vigo_user_service
SPRING_DATASOURCE_USERNAME=admin
SPRING_DATASOURCE_PASSWORD=

# Match the token settings in auth/.env.
AUTH_JWKS_URI=http://auth:8084/.well-known/jwks.json
JWT_ISSUER=auth.vigoapp.ir
JWT_AUDIENCE=vigo-api

# Auth 1.0.3 uses plaintext gRPC. Use this mode on a trusted development network.
SPRING_PROFILES_ACTIVE=dev
GRPC_DEV_PLAINTEXT_ENABLED=true
GRPC_BIND_ADDRESS=0.0.0.0
GRPC_PORT=50051
GRPC_TLS_CERTIFICATE=
GRPC_TLS_PRIVATE_KEY=
GRPC_TLS_TRUST_CERTIFICATE=
GRPC_AUTH_SERVICE_IDENTITY=spiffe://vigo.local/service/auth
GRPC_DEV_AUTH_USER_AGENT=
CREDENTIALS_MAX_AGE=PT0S

# Enable the relay only after configuring a reachable Kafka broker.
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
OUTBOX_ENABLED=false
