# Auth runtime settings
# API and metrics ports inside the container.
SERVER_PORT=8080
MANAGEMENT_SERVER_PORT=8084

# PostgreSQL connection inside Compose
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/vigo_auth_service
# Match postgres/.env.
SPRING_DATASOURCE_USERNAME=admin
SPRING_DATASOURCE_PASSWORD=adminpassword

# RSA keys mounted at /app/.keys inside the auth container
JWT_PRIVATE_KEY_PATH=.keys/private_key.pem
JWT_PUBLIC_KEY_PATH=.keys/public_key.pem
JWT_KEY_ID=vigo-auth-key-1

# User service inside Compose.
USER_GRPC_HOST=user
USER_GRPC_PORT=50051
USER_GRPC_TIMEOUT_MS=3000

# Initial auth settings (for creating a missing settings record)
AUTH_DEFAULT_LOGIN_ENABLED=true
AUTH_DEFAULT_REGISTER_ENABLED=true
# Supported OTP channels: EMAIL, SMS, IN_APP
AUTH_DEFAULT_OTP_CHANNEL=EMAIL
AUTH_DEFAULT_EMAIL_NOTIFICATION_ENABLED=false
AUTH_DEFAULT_SMS_NOTIFICATION_ENABLED=false
AUTH_DEFAULT_IN_APP_NOTIFICATION_ENABLED=false

# JWT token policy
JWT_ISSUER=auth.vigoapp.ir
JWT_AUDIENCE=vigo-api
JWT_ACCESS_TOKEN_TTL=15m

# Redis connection inside Compose
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DATABASE=0

# Authentication security policy
# Generate the OTP secret with: openssl rand -base64 32
AUTH_OTP_SECRET=
AUTH_PASSWORD_OTP_REQUIRED=false
AUTH_OTP_TTL=5m
AUTH_OTP_COOLDOWN=1m
AUTH_OTP_MAX_ATTEMPTS=3
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_FAILURE_WINDOW=30m
AUTH_LOCK_DURATION=1m
AUTH_MAX_LOCK_DURATION=30m
AUTH_IP_MAX_REQUESTS=60
AUTH_IP_WINDOW=1m
AUTH_REFRESH_TOKEN_TTL=7d
AUTH_SESSION_TTL=30d
AUTH_RETENTION=7d
AUTH_CLEANUP_INTERVAL=1h

# An empty value disables scraping. Match prometheus/secrets/auth_metrics_password.
# Generate with: openssl rand -hex 32
AUTH_METRICS_PASSWORD=
